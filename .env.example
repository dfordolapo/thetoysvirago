# Supabase Configuration
# Replace with your Supabase Project URL and Anon Public Key from:
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# BudPay Online Gateway Configuration (Cards, Dynamic Bank Transfer, Apple Pay)
# BudPay Dashboard -> Settings -> API Keys & Webhooks
VITE_BUDPAY_PUBLIC_KEY=pk_test_your_budpay_public_key

# Store Bank Account for Discreet Direct Bank Transfer
VITE_BANK_NAME=Moniepoint MFB
VITE_BANK_ACCOUNT_NUMBER=4585343326
VITE_BANK_ACCOUNT_NAME=Thetoysvirago
VITE_STORE_WHATSAPP=2348036514814

# Resend API Key for Automated Customer Order Confirmation Emails
# Get your API key from https://resend.com/api-keys
VITE_RESEND_API_KEY=your_resend_api_key_here
VITE_RESEND_FROM_EMAIL=TheToysVirago <onboarding@resend.dev>
